#!/usr/bin/env python3
import sys
import socket
import select

def main():
    args = [a for a in sys.argv[1:] if not a.startswith('-')]
    if len(args) < 2:
        sys.stderr.write("Usage: nc <host> <port>\n")
        sys.exit(1)
    host = args[0]
    if host == 'localhost':
        host = '127.0.0.1'
    port = int(args[1])
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.connect((host, port))
    except Exception as e:
        sys.stderr.write(f"Connection failed to {host}:{port}: {e}\n")
        sys.exit(1)
    
    inputs = [s, sys.stdin]
    while inputs:
        try:
            readable, _, _ = select.select(inputs, [], [], 1.0)
            for r in readable:
                if r is s:
                    data = s.recv(4096)
                    if not data:
                        return
                    sys.stdout.buffer.write(data)
                    sys.stdout.flush()
                else:
                    data = sys.stdin.buffer.read1(4096) if hasattr(sys.stdin.buffer, 'read1') else sys.stdin.buffer.read(4096)
                    if not data:
                        try:
                            s.shutdown(socket.SHUT_WR)
                        except Exception:
                            pass
                        inputs.remove(sys.stdin)
                    else:
                        s.sendall(data)
        except (KeyboardInterrupt, BrokenPipeError):
            break

if __name__ == '__main__':
    main()
