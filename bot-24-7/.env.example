# 24/7 Multi-Chain Bot & Listener Environment Variables
# Copy to .env: cp .env.example .env

# Ethereum WebSocket RPC Endpoint (Alchemy, Infura, QuickNode, or PublicNode)
WSS_RPC_URL=wss://ethereum.publicnode.com
ETH_WSS_URL=wss://ethereum.publicnode.com

# Binance Smart Chain (BSC) WebSocket RPC
BSC_WSS_URL=wss://bsc.publicnode.com

# Solana WebSocket RPC
SOL_WSS_URL=wss://api.mainnet-beta.solana.com

# Private Key for Arbitrage / Settlement Execution (Keep server-side, never share)
PRIVATE_KEY=

# Deployed Flash Loan Arbitrage Contract Address
ARBITRAGE_CONTRACT_ADDRESS=0x89205A3A3b2A69De6Dbf7f01ED13B2108B2c43e7

# Redis Connection URL for BullMQ Queue (Optional: In-memory fallback is active if empty)
# REDIS_URL=redis://127.0.0.1:6379

# Flashbots Protect / Private RPC Relay
FLASHBOTS_RPC_URL=https://rpc.flashbots.net
